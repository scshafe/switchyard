{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mission-pipeline.local/pipeline-definition.v2.schema.json",
  "title": "PipelineDefinition v2",
  "description": "The digest-sealed, data-only description of a pipeline DAG: registered stage ids/versions, named input slots, contract versions, nodes, and edges — never module paths, never DB-supplied code. definitionDigest seals the canonical JSON of every other field (stable under key permutation). v2 of the inbox pipeline-definition.v1: a node references its published binding via one content-addressed { kind, bindingId, version, bindingDigest } ref instead of embedding the full model/decision binding payloads (those sealed payloads are owned by the model and decision modules). Schema-first SOURCE for the hand-written LOUD validator in src/definition.ts (createPipelineDefinition / validatePipelineDefinition); test/mission-pipeline-node-model.test.mjs pins the two together. Rules the validator enforces beyond this schema: node IDs unique; per-node input slots unique; description trimmed before sealing; digest recompute on validation (tamper = \"digest mismatch\").",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pipelineId", "version", "description", "inputContract", "nodes", "outputs", "definitionDigest"],
  "properties": {
    "schemaVersion": { "const": "pipeline-definition.v2" },
    "pipelineId": { "$ref": "#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "inputContract": { "$ref": "#/$defs/contractId" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/node" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "definitionDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "stage", "inputs"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "stage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "version": { "type": "integer", "minimum": 1 }
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "source"],
            "properties": {
              "slot": { "$ref": "#/$defs/identifier" },
              "source": { "$ref": "#/$defs/source" }
            }
          }
        },
        "binding": { "$ref": "#/$defs/bindingRef" }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "pipeline_input" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodeId"],
          "properties": {
            "kind": { "const": "node_output" },
            "nodeId": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    },
    "bindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bindingId", "version", "bindingDigest"],
      "properties": {
        "kind": { "enum": ["model", "decision"] },
        "bindingId": { "$ref": "#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1 },
        "bindingDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "contractId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]*\\.v[1-9][0-9]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
