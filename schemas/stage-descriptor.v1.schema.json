{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mission-pipeline.local/stage-descriptor.v1.schema.json",
  "title": "StageDescriptor v1",
  "description": "The typed, versioned identity of a pipeline stage: kind (code|model|agent|gate), 1..16 named input slots with contract versions, an output contract, capability strings, the kind-derived bindingKind, delivery semantics, and an optional configuration fingerprint. Schema-first SOURCE for the hand-written LOUD validator in src/node.ts (validateStageDescriptor); test/mission-pipeline-node-model.test.mjs pins the two together. Rules the validator enforces beyond this schema: input slots unique; capabilities unique and \"none\" never combined with another capability; bindingKind must equal the kind-canonical value (code/agent=none, model=model, gate=decision).",
  "type": "object",
  "additionalProperties": false,
  "required": ["stageId", "version", "kind", "inputs", "outputContract", "deliverySemantics"],
  "properties": {
    "stageId": { "$ref": "#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["code", "model", "agent", "gate"] },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "contract"],
        "properties": {
          "slot": { "$ref": "#/$defs/identifier" },
          "contract": { "$ref": "#/$defs/contractId" }
        }
      }
    },
    "outputContract": { "$ref": "#/$defs/contractId" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "bindingKind": { "enum": ["none", "model", "decision"] },
    "deliverySemantics": { "enum": ["at_most_once", "at_least_once_idempotent"] },
    "configurationFingerprint": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "contractId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]*\\.v[1-9][0-9]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
