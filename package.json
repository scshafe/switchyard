{
  "name": "mission-pipeline",
  "version": "0.2.0",
  "description": "Standalone, dependency-free, digest-sealed compiled-DAG pipeline engine for host applications.",
  "type": "module",
  "license": "MIT",
  "author": "mission-pipeline contributors",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/scshafe/mission-pipeline.git"
  },
  "bugs": {
    "url": "https://github.com/scshafe/mission-pipeline/issues"
  },
  "homepage": "https://github.com/scshafe/mission-pipeline#readme",
  "keywords": [
    "agents",
    "dag",
    "durable-execution",
    "mission-control",
    "pipeline"
  ],
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "npm@10.9.4",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./*": { "types": "./lib/*.d.ts", "default": "./lib/*.js" },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "schemas",
    "sql",
    "LICENSE",
    "README.md",
    "tsconfig.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "test": "node --test test/*.test.mjs",
    "test:payload": "node scripts/check-package-payload.mjs",
    "test:release-artifact": "node scripts/check-release-artifact.mjs",
    "test:install": "node scripts/check-pack-install.mjs",
    "test:postgres:reference": "node scripts/check-postgres-reference.mjs",
    "test:fresh-clone": "node scripts/check-fresh-clone.mjs",
    "check": "npm run build && npm run test && npm run test:payload && npm run test:release-artifact && npm run test:install",
    "verify": "npm run clean && npm run check && git diff --exit-code -- lib",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
