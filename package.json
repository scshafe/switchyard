{
  "name": "mission-pipeline",
  "version": "0.1.0",
  "description": "Standalone, dependency-free, digest-sealed compiled-DAG pipeline engine for Mission Control projects.",
  "type": "module",
  "license": "MIT",
  "author": "mission-pipeline contributors",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/scshafe/mission-pipeline.git"
  },
  "bugs": {
    "url": "https://github.com/scshafe/mission-pipeline/issues"
  },
  "homepage": "https://github.com/scshafe/mission-pipeline#readme",
  "keywords": [
    "agents",
    "dag",
    "durable-execution",
    "mission-control",
    "pipeline"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./*": { "types": "./lib/*.d.ts", "default": "./lib/*.js" },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "schemas",
    "sql",
    "LICENSE",
    "README.md",
    "tsconfig.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run test && npm run pack:check",
    "pack:check": "npm pack --dry-run --json",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
