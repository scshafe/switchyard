{
  "name": "@scshafe/switchyard",
  "version": "2.1.0",
  "description": "Standalone, dependency-free, digest-sealed node-graph engine for host applications.",
  "type": "module",
  "license": "MIT",
  "author": "switchyard contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/scshafe/switchyard.git"
  },
  "bugs": {
    "url": "https://github.com/scshafe/switchyard/issues"
  },
  "homepage": "https://github.com/scshafe/switchyard#readme",
  "keywords": [
    "agents",
    "node-graph",
    "durable-execution",
    "workflow",
    "pipeline"
  ],
  "engines": {
    "node": ">=22.22.0 <23 || >=24.18.0 <25"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./*": { "types": "./lib/*.d.ts", "default": "./lib/*.js" },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "schemas",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "tsconfig.json"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json && tsc -p packages/switchyard-graphpaper/tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "test": "node --test test/*.test.mjs",
    "test:v1-deletion": "node scripts/check-v1-deletion.mjs",
    "test:payload": "node scripts/check-package-payload.mjs",
    "test:release-artifact": "node scripts/check-release-artifact.mjs",
    "test:install": "node scripts/check-pack-install.mjs",
    "test:graphpaper-sdk": "node scripts/check-graphpaper-sdk.mjs",
    "test:fresh-clone": "node scripts/check-fresh-clone.mjs",
    "check": "pnpm run test:v1-deletion && pnpm run build && pnpm run test && pnpm run test:payload && pnpm run test:release-artifact && pnpm run test:install && pnpm run test:graphpaper-sdk",
    "verify": "pnpm run clean && pnpm run check",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify",
    "release:manifest": "node scripts/write-release-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "elkjs": "0.10.2",
    "graphpaper": "git+https://github.com/scshafe/graphpaper.git#89240f15c171a26009430ad7eb45eb85ac2567aa",
    "typescript": "^5.8.3"
  }
}
